# Every variable is optional — the server starts without a .env file.

# Port the Node server listens on
PORT=3000

# Path to SQLite database file
SQLITE_PATH=data.db

# Optional: GitHub webhook secret for POST /api/deploy (responds 503 when unset)
# DEPLOY_SECRET=

# Optional: TMDB API read token for watch search/import (TMDB endpoints respond 503 when unset)
# TMDB_API_KEY=

# Optional: person filmography sort — billing | harmonic | decay | three-way | geometric (default: decay)
# TMDB_PERSON_SORT=decay

# Optional: PixelLab API token for the asset tooling (see docs/pixellab/README.md)
# PIXELLAB_SECRET=

# Optional: asset workspace root for the asset tooling, e.g. ~/Dropbox/games (assets never live in this repo)
# GAME_ASSETS_DIR=
